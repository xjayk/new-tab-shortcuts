{
  "manifest_version": 3,
  "name": "New Tab Shortcuts",
  "version": "1.0.0",
  "description": "A fast, minimal new tab page with grouped shortcuts that sync across devices.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
